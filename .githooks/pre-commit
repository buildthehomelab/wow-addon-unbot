#!/bin/sh
# Bumps the UnBot patch version (## Version: in UnBot.toc) on every commit,
# so each commit carries its own version.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one commit:    git commit --no-verify
# Bump major/minor:       edit the TOC by hand, e.g. to 0.5.0; the next commit is 0.5.1
set -e

toc="UnBot/UnBot.toc"
perl -pi -e 's/^(## Version: v?\d+\.\d+\.)(\d+)/$1.($2 + 1)/e' "$toc"
git add "$toc"
